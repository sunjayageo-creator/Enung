    .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px;margin-top:20px}
    .card{background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));padding:18px;border-radius:12px;box-shadow:0 6px 18px rgba(0,0,0,0.6);border:1px solid var(--glass)}
    .card h3{margin:0 0 8px;font-size:18px}
    .muted{color:var(--muted);font-size:14px}

    .btn{display:inline-block;padding:10px 14px;border-radius:10px;background:var(--accent);color:#05293b;font-weight:600;text-decoration:none}
    footer{margin-top:36px;color:var(--muted);font-size:14px;text-align:center}

    /* responsive tweaks */
    @media(min-width:720px){
      .hero{grid-template-columns:1fr 320px}
      h1{font-size:34px}
    }

    /* tiny util */
    .tags{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
    .tag{background:rgba(255,255,255,0.03);padding:6px 8px;border-radius:8px;font-size:13px;color:var(--muted)}

